{
  "name": "ad-app-deploy-manager",
  "version": "1.2.11",
  "description": "Active Directory App Deployment Manager - Drop & Run GPO System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "node build-portable.cjs",
    "build:dir": "node build-portable.cjs --dir",
    "test": "node tests/run-tests.cjs",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "dev.andresgp.addeploymanager",
    "productName": "AD Deploy Manager",
    "directories": {
      "output": "codex/bin/mod-rev-2.1",
      "buildResources": "img"
    },
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "es",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "services/**/*",
      "renderer/**/*",
      "LICENSE",
      "!**/*.md",
      "!**/*.map",
      "!**/.DS_Store",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!.editorconfig",
      "!.git",
      "!dist/${/*}",
      "!dist_portable/${/*}"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ADDeployManager-Portable.exe"
    }
  },
  "author": "gpandres",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "acorn": "8.19.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
